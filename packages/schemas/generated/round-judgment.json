{
  "type": "object",
  "properties": {
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "enum": [
              "problem",
              "market",
              "wtp",
              "differentiation",
              "moat",
              "timing",
              "gtm",
              "feasibility",
              "scale"
            ]
          },
          "comparison": {
            "type": "string"
          },
          "fighter_1": {
            "type": "object",
            "properties": {
              "rationale": {
                "type": "string",
                "description": "Written before the score."
              },
              "capsApplied": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Cap ids applied to this score. Empty if none."
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Integer from 0 to 10. Write the rationale before choosing this."
              }
            },
            "required": [
              "rationale",
              "capsApplied",
              "score"
            ],
            "additionalProperties": false
          },
          "fighter_2": {
            "type": "object",
            "properties": {
              "rationale": {
                "type": "string",
                "description": "Written before the score."
              },
              "capsApplied": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Cap ids applied to this score. Empty if none."
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Integer from 0 to 10. Write the rationale before choosing this."
              }
            },
            "required": [
              "rationale",
              "capsApplied",
              "score"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "criterion",
          "comparison",
          "fighter_1",
          "fighter_2"
        ],
        "additionalProperties": false
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "landed",
              "partial",
              "glancing",
              "parried",
              "whiff"
            ],
            "description": "For a defense shot, landed means the defense worked."
          },
          "impact": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ],
            "description": "How much the shot matters to this round, from 0 to 3."
          },
          "note": {
            "type": "string",
            "description": "Under 20 words."
          }
        },
        "required": [
          "shotId",
          "verdict",
          "impact",
          "note"
        ],
        "additionalProperties": false
      },
      "description": "One verdict per shot in the round."
    },
    "injectionSuspected": {
      "type": "boolean"
    },
    "roundSummary": {
      "type": "string",
      "description": "At most 60 words."
    }
  },
  "required": [
    "criteria",
    "shots",
    "injectionSuspected",
    "roundSummary"
  ],
  "additionalProperties": false,
  "title": "RoundJudgment",
  "description": "Scores for one round's three criteria, plus a verdict for every shot in the round."
}
