{
  "name": "@sf-fight-club/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SF Fight Club web app: arena, Tower, cards, film room, art library.",
  "scripts": {
    "dev": "pnpm --filter @sf-fight-club/schemas build && pnpm --filter @sf-fight-club/engine build && vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @sf-fight-club/schemas build && pnpm --filter @sf-fight-club/engine build && pnpm run typecheck && vitest run",
    "screenshots": "pnpm --filter @sf-fight-club/schemas build && pnpm --filter @sf-fight-club/engine build && pnpm run build && tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@sf-fight-club/engine": "workspace:*",
    "@sf-fight-club/schemas": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@sf-fight-club/intake": "workspace:*",
    "@sf-fight-club/orchestrator": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
